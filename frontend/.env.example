# Acessos de teste do banco: docs/ACESSOS-DE-TESTE.md
#
# Este arquivo é OPCIONAL: sem .env o front já chama o backend Spring Boot
# (http://localhost:8080) pelo proxy do `npm run dev`. Copie para .env.local
# só se precisar mudar algum valor abaixo.

# Prefixo das rotas da API no front.
# Com "/api", o Vite repassa as chamadas para VITE_BACKEND_URL (sem CORS em dev).
# Em produção, pode ser a URL completa: https://api.prontto.app/api
VITE_API_URL=/api

# Onde o Spring Boot está rodando (usado só pelo proxy do `npm run dev`).
VITE_BACKEND_URL=http://localhost:8080

# Tempo máximo de espera de cada requisição, em milissegundos.
VITE_API_TIMEOUT_MS=15000
